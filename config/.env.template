# ==========================================
# Pipeline Environment Variables
# Copy this to .env or set in your shell
# ==========================================

# --- RixTrema vLLM (генерация HTML, по умолчанию) ---
VLLM_BASE=https://rixtrema.net/api/vllm/v1
VLLM_KEY=your_rixtrema_key_here
# VLLM_MODEL=openai/gpt-oss-120b  # опционально

# --- DeepSeek (альтернатива для генерации) ---
# VLLM_BASE=https://api.deepseek.com
# VLLM_KEY=your_deepseek_key_here
# VLLM_MODEL=deepseek-chat

# --- OpenAI (через Gateway, для Vision QA) ---
# GATEWAY_URL=http://127.0.0.1:18789
# GATEWAY_TOKEN=your_gateway_token_here

# --- Claude Anthropic (альтернатива для Vision QA) ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Vision QA backend (gateway | rixtrema | claude) ---
VISION_BACKEND=gateway

# --- OpenClaw Gateway ---
# OPENCLAW_GATEWAY_PORT=18789
